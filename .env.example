# ==== Salin ke .env lalu GANTI semua nilai rahasia ====
ENV=development
PUBLIC_ORIGIN=http://localhost
# Cookie sesi: auto (ikut protokol), true (paksa HTTPS), false (izinkan http — untuk uji coba di jaringan lokal)
COOKIE_SECURE=auto

POSTGRES_DB=nexvora
# Role owner: dipakai HANYA oleh container migrate
POSTGRES_OWNER_USER=nexvora_owner
POSTGRES_OWNER_PASSWORD=ganti-owner-password-panjang
# Role runtime API: NOBYPASSRLS, bukan owner tabel
APP_DB_USER=nexvora_app
APP_DB_PASSWORD=ganti-app-password-panjang

REDIS_PASSWORD=ganti-redis-password

# Minimal 32 karakter acak: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Reservasi stok order yang BELUM dibayar dilepas otomatis setelah N menit
RESERVATION_TTL_MINUTES=60

# Toleransi selisih berat paket di packing station (persen)
PACK_WEIGHT_TOLERANCE_PCT=10

# ===== Langganan (SaaS) =====
SIGNUP_ENABLED=true
TRIAL_DAYS=14
GRACE_DAYS=7
# manual = transfer bank, dikonfirmasi super admin | midtrans = VA/QRIS/e-wallet otomatis
BILLING_PROVIDER=manual
BANK_TRANSFER_INFO=Transfer ke BCA 1234567890 a.n. PT Contoh Nusantara.
# Diisi bila BILLING_PROVIDER=midtrans (Server Key dari dashboard Midtrans)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# ===== Pengiriman =====
# Kunci enkripsi API key kurir di database. WAJIB di production dan JANGAN diganti setelah dipakai.
# Buat: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# Kecepatan kurir simulasi (detik per status) — hanya untuk demo
SIMULATOR_STEP_SECONDS=60

# ===== Notifikasi email (opsional; tanpa ini notifikasi tetap tampil di aplikasi & webhook) =====
# Contoh Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=alamat@gmail.com, SMTP_PASSWORD=<App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Nexvora <no-reply@domainanda.com>

# ===== Skala & observability (Fase 6) =====
# Token untuk endpoint /metrics (Prometheus). Kosong = tanpa token (aman karena Nginx menutup /metrics dari publik).
METRICS_TOKEN=
# Pekerjaan yang dijalankan proses worker ini: maintenance, dispatcher, atau keduanya (pisahkan koma)
WORKER_JOBS=maintenance,ai,dispatcher
# Saluran event: db (outbox saja) atau redis (outbox + Redis Stream untuk konsumen lain)
EVENT_BUS=db
# Read replica khusus laporan/analitik (opsional). Contoh: postgresql+asyncpg://user:pw@replica:5432/nexvora
DATABASE_READ_URL=
# Batas waktu satu query di koneksi read replica (milidetik)
STATEMENT_TIMEOUT_MS=15000

# ===== Asisten dalam aplikasi =====
# auto = pakai Claude bila ANTHROPIC_API_KEY diisi, selain itu mode aturan (tanpa kirim data ke luar)
ASSISTANT_ENGINE=auto
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-4-5

# Bootstrap super admin (sekali jalan)
BOOTSTRAP_ADMIN_EMAIL=admin@perusahaan-anda.co.id
BOOTSTRAP_ADMIN_PASSWORD=Ganti-Password-Kuat-2026!
